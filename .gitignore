# Quarto
/_book/
/.quarto/
/_freeze/
*_files/
# Rendered standalone reveal.js decks (sources are the slides/*.qmd stubs +
# the full follow-along decks in slides/full/); *_files/ already covered above.
/slides/*.html
/slides/full/*.html
# Presenter answer key: track the generator + final HTML, not the intermediate md
/presenter/answer-key.md

# History / session files
.Rhistory
.Rapp.history
.RData
.Ruserdata

# RStudio
.Rproj.user/

# renv (library is not committed; lockfile is)
/renv/library/
/renv/staging/

# Example code in package build process
*-Ex.R

# Output files from R CMD build / check
/*.tar.gz
/*.Rcheck/

# knitr / R Markdown caches and temporaries
/*_cache/
/cache/
*.utf8.md
*.knit.md

# Misc
.httr-oauth
rsconnect/
.DS_Store

**/*.quarto_ipynb
